# 复制此文件为 .env，再填入自己的密钥。不要把 .env 提交或发给别人。

# 火山方舟 Agent Plan 企业版：必须使用 Agent Plan 专属 Key，
# 不是普通方舟平台的 API Key。
ARK_API_KEY=your-agent-plan-key
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENAI_MODEL=ark-code-latest

# 生产环境：Nginx 反代到本机时保持 127.0.0.1；Docker 内或直接对外监听用 0.0.0.0。
HOST=127.0.0.1

# 放在 Nginx/Caddy 后面时设为 1，才能按真实访客 IP 限流。
# 不要把设为 1 的 Node 服务直接暴露到公网，否则来源 IP 可被伪造。
TRUST_PROXY=0

# 可选：方舟图片搜索地址。通常保持默认即可。
# IMAGE_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search

# 如果控制台要求填写具体 Model Name，可把上面的模型名替换为控制台显示的模型，
# 例如 doubao-seed-2-1-pro-260628。以企业版控制台实际可用列表为准。

# 若改用 OpenAI，替换成下列三项即可：
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# 本地网站端口，按需修改。
PORT=8787
